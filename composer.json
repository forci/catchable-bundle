{
    "name": "forci/catchable-bundle",
    "type": "symfony-bundle",
    "description": "A bundle to collect your unhandled exceptions",
    "keywords": ["exception bundle", "forci", "wucdbm"],
    "authors": [
        {
            "name": "Tatyana Mincheva",
            "email": "tatjana@forci.com",
            "role": "Developer"
        },
        {
            "name": "Martin Kirilov",
            "email": "wucdbm@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.4.1",
        "symfony/framework-bundle": "~8.0",
        "symfony/form": "~8.0",
        "monolog/monolog": "^3",
        "doctrine/doctrine-bundle": "~3.0",
        "doctrine/orm": "~3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "v3.95.27",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": { "Forci\\Bundle\\Catchable\\": "src" }
    },
    "autoload-dev": {
        "psr-4": { "Forci\\Bundle\\Catchable\\Tests\\": "tests" }
    },
    "config": {
        "bin-dir": "bin"
    },
    "license": "MIT"
}
